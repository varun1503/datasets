<mxfile host="app.diagrams.net">
  <diagram name="Request flow" id="mpn-cache-flow">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="A" value="User uploads Excel / asks a follow-up question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="B" value="Extract requested MPNs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="C" value="Normalize MPNs&lt;br&gt;Trim, uppercase, remove spaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="D" value="Deduplicate MPNs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="270" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="E" value="Query PostgreSQL cache&lt;br&gt;for this chat session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="350" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="F" value="Valid cache entry found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="440" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="G" value="Reuse cached result" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="H" value="Call external web search API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="590" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="I" value="Search successful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="560" y="680" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="J" value="Bulk upsert results&lt;br&gt;into PostgreSQL cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="705" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="K" value="Handle search failure&lt;br&gt;without caching as success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="830" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="L" value="Combine cached and fresh results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="880" width="240" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="M" value="Return results only for&lt;br&gt;the requested MPNs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="960" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="N" value="Record activity in existing audit logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="280" y="1050" width="240" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="eAB" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eBC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCD" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="C" target="D"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eDE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="D" target="E"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eEF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eFG" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="G"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eFH" value="No: miss / expired / bypass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="F" target="H"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eHI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="H" target="I"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eIJ" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="I" target="J"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eIK" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="I" target="K"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eJL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="J" target="L"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eGL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="G" target="L"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eKL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="K" target="L"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eLM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="L" target="M"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eMN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="M" target="N"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eEH" value="Cache DB unavailable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="E" target="H">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="380"/>
              <mxPoint x="860" y="615"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eJLd" value="Cache write fails" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="J" target="L"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
