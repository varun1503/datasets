<mxfile host="app.diagrams.net">
  <diagram name="Architecture" id="mpn-cache-arch">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="U" value="User&lt;br&gt;Excel upload / chat question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="API" value="Existing Chatbot API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="120" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="PROC" value="MPN Processing Layer&lt;br&gt;Extract · Normalize · Deduplicate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="CACHE" value="Cache Service&lt;br&gt;Lookup · Merge · Upsert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="220" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="SEARCH" value="External Web Search API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="200" y="470" width="220" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="AUDIT" value="Existing Audit Logs&lt;br&gt;Interaction / Retrieval Logs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="560" y="105" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="CLEAN" value="Scheduled Cleanup Job&lt;br&gt;Delete expired cache rows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="230" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="DB" value="PostgreSQL&lt;br&gt;mpn_search_cache" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="200" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="MON" value="Monitoring&lt;br&gt;Hit ratio · Latency · Errors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="620" width="560" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="eUA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="U" target="API"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eAP" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="API" target="PROC"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ePC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="PROC" target="CACHE"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eCD" value="Batch lookup / bulk upsert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;startArrow=block;startFill=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="CACHE" target="DB"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCS" value="Cache misses or force refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="CACHE" target="SEARCH"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eSC" value="Fresh search results" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="SEARCH" target="CACHE"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eAA" value="Request / retrieval activity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="API" target="AUDIT"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eCL" value="Batched deletion of expired rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="CLEAN" target="DB"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="eCM" value="Cache hit / miss metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="CACHE" target="MON">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="120" y="350"/>
              <mxPoint x="120" y="650"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eSM" value="API latency / errors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="SEARCH" target="MON"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="eDM" value="DB errors / table size" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="DB" target="MON"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
