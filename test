sudo apt install -y apt-transport-https ca-certificates gnupg curl
curl https://google.com | sudo gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg
echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://google.com cloud-sdk main" | sudo tee -a /etc/apt/sources.list.d/google-cloud-sdk.list
